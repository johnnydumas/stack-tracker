{
  "name": "stack-task-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute stack-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute stack-db --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
